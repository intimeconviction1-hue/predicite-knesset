# Copier ce fichier en .env (jamais commité) et remplir les valeurs.

# Connexion à la base Postgres (Neon, Supabase, ou un Postgres local pour le
# dev). Remplace DB_PATH/SQLite depuis le 2026-07-24 — voir le commentaire en
# tête de server/db/index.js pour le pourquoi (disque persistant gratuit
# introuvable chez les hébergeurs PaaS en 2026 ; Postgres géré évite ce besoin
# côté serveur web). Format : postgresql://user:password@host:port/dbname
# (Neon/Supabase ajoutent souvent ?sslmode=require, laisser tel quel).
DATABASE_URL=

# Port d'écoute du serveur Express
PORT=8788

# 'production' pour servir le build client/dist directement depuis Express.
# Laisser vide ou 'development' en local avec Vite séparé.
NODE_ENV=development

# Secret de session — À CHANGER avant toute mise en ligne, même privée.
SESSION_SECRET=change-moi

# Emails qui reçoivent le rôle admin dès leur première connexion, séparés par
# des virgules. Le tout premier compte créé sur l'instance devient admin de
# toute façon (utile en local), ceci sert surtout après un premier déploiement.
ADMIN_EMAILS=

# Nécessaire pour le collecteur de sondages (sondagesSiegesCollector), qui
# appelle l'API Anthropic avec l'outil de recherche web.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# true uniquement si le serveur est servi en HTTPS (cookie de session "secure")
COOKIE_SECURE=false
